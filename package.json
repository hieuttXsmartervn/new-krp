{
  "name": "ikak-members-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "pnpm --filter @ikak/web build",
    "lint": "pnpm --filter @ikak/web lint",
    "typecheck": "pnpm --filter @ikak/web typecheck",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,mjs,json}\" \"packages/shared/**/*.ts\" \"docs/**/*.md\" package.json tsconfig.base.json README.md",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,mjs,json}\" \"packages/shared/**/*.ts\" \"docs/**/*.md\" package.json tsconfig.base.json README.md",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "prettier": "^3.5.3"
  }
}
